## Database: Supabase Postgres (Project settings -> Database -> Connection pooling).
## DATABASE_URL = transaction pooler, port 6543 (runtime). DIRECT_URL = session pooler, port 5432 (migrations;
## required on Vercel Production too, because every production deploy applies new migrations with it).
## Percent-encode special characters in the password (for example @ becomes %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

## Auth (Better Auth + Google sign-in)
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
## Comma-separated emails that become ADMIN on first sign-in. Everyone else needs a row in allowed_emails.
BOOTSTRAP_ADMIN_EMAILS=""

## Private file storage (uploaded PDFs, signature): the Supabase project's URL and secret key. Server-side only.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

## 32-byte key for encrypting PAN/bank fields at rest.
APP_ENCRYPTION_KEY=""  # 32 random bytes, base64: openssl rand -base64 32

## Shared secret for Vercel Cron routes under /api/cron/*
CRON_SECRET=""

NEXT_PUBLIC_APP_NAME="ReShuffle Dashboard"

# Websites allowed to upload PDFs to /api/ingest/documents from a browser (comma separated).
# Defaults to the invoice software, https://invoice-eight-neon.vercel.app
# INGEST_ALLOWED_ORIGINS=
