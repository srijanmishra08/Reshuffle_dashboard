## Database. Turso (libsql://) in production; a local file works for dev and tests.
## Use a SEPARATE database for local development, never the production one.
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

## Auth (Better Auth + Google sign-in)
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
## Comma-separated emails that become ADMIN on first sign-in. Everyone else needs a row in allowed_emails.
BOOTSTRAP_ADMIN_EMAILS=""

## Files (logo, signature, PDFs). Needed from Phase 2.
BLOB_READ_WRITE_TOKEN=""

## 32-byte key for encrypting PAN/bank fields at rest (Phase 4).
APP_ENCRYPTION_KEY=""

## Shared secret for Vercel Cron routes under /api/cron/*
CRON_SECRET=""

NEXT_PUBLIC_APP_NAME="ReShuffle Dashboard"
