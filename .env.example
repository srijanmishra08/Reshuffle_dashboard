## Database: Supabase Postgres (Project settings -> Database -> Connection pooling).
## DATABASE_URL = transaction pooler, port 6543 (runtime). DIRECT_URL = session pooler, port 5432 (migrations).
## Percent-encode special characters in the password (for example @ becomes %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

## Auth (Better Auth + Google sign-in)
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
## Comma-separated emails that become ADMIN on first sign-in. Everyone else needs a row in allowed_emails.
BOOTSTRAP_ADMIN_EMAILS=""

## Files (logo, signature, PDFs). Needed from Phase 2.
BLOB_READ_WRITE_TOKEN=""

## 32-byte key for encrypting PAN/bank fields at rest (Phase 4).
APP_ENCRYPTION_KEY=""

## Shared secret for Vercel Cron routes under /api/cron/*
CRON_SECRET=""

NEXT_PUBLIC_APP_NAME="ReShuffle Dashboard"
